# Postgres password (used by both the db and app containers)
POSTGRES_PASSWORD=change-me

# Shown on the privacy policy page as the contact for questions and data requests
CONTACT_EMAIL=

# Public URL the app is served at (your Cloudflare tunnel hostname)
AUTH_URL=https://trips.example.com
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Keeps pages from the previous version working during a deploy; keep it the
# same across deploys. Generate once with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare tunnel token (Zero Trust > Networks > Tunnels). Point the public
# hostname's service at http://app:3000
CLOUDFLARE_TUNNEL_TOKEN=

# SMTP for invitation emails. Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); otherwise STARTTLS is used when offered
SMTP_SECURE=false
# "true" to accept a self-signed certificate (e.g. a Postfix relay on your
# own LAN). Leave false for public mail providers.
SMTP_ALLOW_SELF_SIGNED=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="TripSplit <trips@example.com>"

# Timezone for server-side default dates, e.g. America/New_York
TZ=UTC

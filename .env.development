# Defaults for `npm run dev`; safe to commit. Put personal overrides (e.g.
# real Google OAuth credentials) in .env.development.local, which is ignored.
DATABASE_URL=postgres://tripsplit:tripsplit@localhost:5432/tripsplit
AUTH_URL=http://localhost:3000
AUTH_SECRET=dev-only-secret-do-not-use-in-production
AUTH_TRUST_HOST=true

# Shows "sign in as test user" buttons on the sign-in page (dev server only).
DEV_LOGIN=true

# Mailpit from compose.dev.yml
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="TripSplit Dev <dev@tripsplit.local>"

# To test real Google sign-in locally, add to .env.development.local:
#   AUTH_GOOGLE_ID=...
#   AUTH_GOOGLE_SECRET=...
# with redirect URI http://localhost:3000/api/auth/callback/google
